#------------------------------------------------------------------------------
# File:         birdid.config
#
# Description:  Registers the birdid XMP namespace (http://ns.birdpipeline/1.0/)
#               with ExifTool so the bird-ID fields show up as XMP-bird:*
#               with friendly names instead of the generic XMP-ns0:*.
#
# Install (one file):
#   Linux/macOS : save as ~/.ExifTool_config
#   Windows     : save as C:\Users\<you>\.ExifTool_config
#   (or test without installing:  exiftool -config birdid.config ... )
#
# IMatch uses ExifTool internally and loads the same definitions from its own
# config file (imatch_et.config) - add the two hashes below to that file and
# 'touch' it so IMatch re-imports the tags (see IMatch help > ExifTool).
#------------------------------------------------------------------------------

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        # 'bird' must match the NAMESPACE prefix used in the table below
        bird => {
            SubDirectory => {
                TagTable => 'Image::ExifTool::UserDefined::bird',
            },
        },
    },
);

%Image::ExifTool::UserDefined::bird = (
    GROUPS   => { 0 => 'XMP', 1 => 'XMP-bird', 2 => 'Bird' },
    NAMESPACE => { 'bird' => 'http://ns.birdpipeline/1.0/' },
    WRITABLE => 'string',
    # the keys below must match the exact XML element names birdid writes
    species         => { List => 'Seq' },
    confidence      => { List => 'Seq' },
    summary         => { },
    topSpecies      => { },
    scientificName  => { },
    avibaseId       => { },
    avibaseUrl      => { },
    topConfidence   => { },
    confirmed       => { },
    status          => { },
    pipelineVersion => { },
    region          => { },
    month           => { },
    datetime        => { },
    reasoning       => { },
    dcOwned         => { },
    error           => { },
    # "contains multiple birds" re-runnable request (viewer toggle; honored by
    # the pipeline's --multi). The pipeline writes the per-bird records as a
    # Seq of structs (normalized box + that bird's own ranked candidate list);
    # the struct definition keeps exiftool's -j output as real objects (with
    # -struct) and makes the tags writable here.
    multiBird       => { },
    birdCount       => { },
    regions         => {
        List => 'Seq',
        Struct => {
            TYPE => 'XMP::bird',
            x => { },
            y => { },
            w => { },
            h => { },
            manual => { },
            topSpecies => { },
            topConfidence => { },
            status => { },
            species => { List => 'Seq' },
            confidence => { List => 'Seq' },
            reasoning => { },
            # A USER-CONFIRMED region (written by the pipeline's
            # --confirm --bird-region N, the per-bird counterpart of the
            # capture dwc block): the per-bird verdict + its own DarwinCore-
            # mirroring taxonomy ladder (scientificName + kingdom/phylum/class/
            # order/family/genus/specificEpithet) + verification markers
            # (dateIdentified / identificationVerificationStatus). Unconfirmed
            # regions carry none of these.
            confirmed => { },
            dateIdentified => { },
            identificationVerificationStatus => { },
            scientificName => { },
            kingdom => { },
            phylum => { },
            class => { },
            order => { },
            family => { },
            genus => { },
            specificEpithet => { },
        },
    },
);

# register the namespace so ExifTool uses the 'bird' prefix for group names
require Image::ExifTool::XMP;
Image::ExifTool::XMP::RegisterNamespace(\%Image::ExifTool::UserDefined::bird);

1;  #end
