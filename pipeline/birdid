#!/usr/bin/env bash
# birdid - one-command offline bird-photo identification + data management.
#
# Photo identification (default mode):
#   birdid /path/to/photos [extra birdid.py args...]
#
# Data management (no folder needed; these need the network once):
#   birdid --list [country|region]     # what's available to download
#   birdid --download <code>           # write a real eBird table to the
#                                      # gitignored regions_generated/ dir
#                                      # (needs --api key; never committed)
#   birdid --download region SA        # batch: whole continent/subcontinent
#                                      # (NA/SA/AF/AS/OC, EU-NORTH, AS-SOUTHEAST,
#                                      # NA-CARIBBEAN, ...) -- see --list region
#   birdid --download taxonomy         # fetch the keyless eBird/Clements taxonomy
#   birdid --api [<key>]               # store / show the eBird API key
#   birdid --initialize                # one-time: taxonomy + BioCLIP 2 backends
#   birdid --download-backends         # (same backend part as --initialize)
#   birdid --list-candidates           # inspect the region/month tables
#
# Exit codes:
#   0  success (or nothing to do)
#   1  pipeline error / FATAL
set -u

# ---- config ---------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# prefer the project venv (BioCLIP backend) if present
VENV="$SCRIPT_DIR/.venv"
if [ -x "$VENV/bin/python" ]; then
    PY="${BIRDID_PY:-$VENV/bin/python}"
else
    PY="${BIRDID_PY:-python3}"
fi
PIPELINE="$SCRIPT_DIR/birdid.py"

# ---- helpers --------------------------------------------------------------
say() { printf '%s\n' "$*"; }
die() { printf 'birdid: ERROR: %s\n' "$*" >&2; exit 1; }

# ---- main -----------------------------------------------------------------
if [ "$#" -eq 0 ]; then
    say "usage: birdid /path/to/photos [birdid.py args...]"
    say ""
    say "data management (no folder):"
    say "  birdid --list [country|region]     what's available to download"
    say "  birdid --download <code>           write a real eBird table to the"
    say "                                     gitignored regions_generated/ dir"
    say "                                     (needs --api key; never committed)"
    say "  birdid --download taxonomy         fetch the keyless eBird/Clements"
    say "                                     taxonomy (no key needed)"
    say "  birdid --download region SA        batch: whole continent/subcontinent"
    say "                                     (NA/SA/AF/AS/OC, EU-NORTH,"
    say "                                     AS-SOUTHEAST, NA-CARIBBEAN, ...)"
    say "  birdid --api [<key>]               store / show the eBird API key"
    say "  birdid --initialize                one-time: taxonomy + BioCLIP 2 backends"
    say "  birdid --list-candidates           inspect the region/month tables"
    say ""
    say "run 'birdid --help' for all options"
    exit 2
fi

# sanity: the pipeline script exists
[ -f "$PIPELINE" ] || die "pipeline not found: $PIPELINE"

# management commands run WITHOUT a photo folder and may need the network
# (--download / --api / --initialize / --download-backends); --list and
# --list-candidates are local-only but harmless to run online. Everything that
# has a folder is a real identification run and must stay fully offline.
MGMT=0
for a in "$@"; do
    case "$a" in
        -d|--download|--list|--api|--initialize|--download-backends|--list-candidates|-h|--help)
            MGMT=1 ;;
        --download=*|--list=*|--api=*|--initialize=*) MGMT=1 ;;
    esac
done

if [ "$MGMT" -eq 0 ]; then
    # real run: guarantee fully-offline operation. The BioCLIP/TOL backends are
    # predownloaded with `--initialize` / `--download-backends`.
    export HF_HUB_OFFLINE=1
    export TRANSFORMERS_OFFLINE=1
fi

"$PY" "$PIPELINE" "$@"
rc=$?

exit "$rc"
