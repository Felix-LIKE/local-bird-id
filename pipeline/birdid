#!/usr/bin/env bash
# birdid - one-command offline bird-photo identification + data management.
#
# Photo identification (default mode):
#   birdid /path/to/photos [extra birdid.py args...]
#   birdid /path/to/photos --burst      # combine a rapid series of shots of the
#                                       # same bird into one stronger ID (opt-in;
#                                       # tune with --burst-gap / --burst-sim)
#
# Data management (no folder needed; these need the network once):
#   birdid --list [country|region]     # what's available to download
#   birdid --download <code>           # write a real eBird table to the
#                                      # gitignored regions_generated/ dir
#                                      # (needs --api key; never committed)
#   birdid --update <code>             # refresh only the tables whose eBird data
#                                      # is newer than what's stored (default
#                                      # target = current year)
#   birdid --download region SA        # batch: whole continent/subcontinent
#                                      # (NA/SA/AF/AS/OC, EU-NORTH, AS-SOUTHEAST,
#                                      # NA-CARIBBEAN, ...) -- see --list region
#   birdid --download taxonomy         # fetch the keyless eBird/Clements taxonomy
#   birdid --cache build|clean|update [REGION...]
#                                     # manage the species-embedding cache: build
#                                     # = precompute a region's embeddings, clean
#                                     # = remove a region's data / stale species,
#                                     # update = sync with the current eBird tables
#   birdid --api [<key>]               # store / show the eBird API key
#   birdid --initialize                # one-time: taxonomy + BioCLIP 2 backends
#   birdid --download-backends         # (same backend part as --initialize, plus
#                                      # the int8 ONNX image encoder for the
#                                      # fast CPU path)
#   birdid --download-detector         # (optional) dedicated ONNX multi-bird
#                                      # detector - separate, opt-in download
#   birdid --device auto|npu|cpu       # compute device for the image encoder:
#                                      # auto = NPU when present+usable, else CPU
#   birdid --onnx-encoder              # OPT-IN: int8 ONNX CPU image encoder
#                                      # (torch is the default; installing
#                                      # onnxruntime for the ONNX detector
#                                      # does NOT flip the encoder)
#   birdid --no-onnx-encoder           # force the pybioclip CPU encoder (no int8
#                                      # ONNX fast path) even when opted in
#   birdid --list-candidates           # inspect the region/month tables
#   birdid --doctor                    # launcher self-diagnostics (run whenever
#                                      # a run ends in a confusing bash error)
#
# Exit codes:
#   0  success (or nothing to do)
#   1  pipeline error / FATAL
set -u

# ---- portable path resolution ---------------------------------------------
# GNU `readlink -f` where available, else Python's os.path.realpath (python3 is
# a hard requirement of the whole tool anyway). This is the one place macOS's
# BSD readlink (no -f flag) would otherwise break the launcher.
_realpath() {
    local p
    if p="$(readlink -f -- "$1" 2>/dev/null)"; then
        printf '%s\n' "$p"
    elif command -v python3 >/dev/null 2>&1; then
        python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$1"
    else
        printf '%s\n' "$1"
    fi
}

# ---- config ---------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "$(_realpath "${BASH_SOURCE[0]}")")" && pwd)"
# prefer the project venv (BioCLIP backend) if present
VENV="$SCRIPT_DIR/.venv"
if [ -x "$VENV/bin/python" ]; then
    PY="${BIRDID_PY:-$VENV/bin/python}"
else
    PY="${BIRDID_PY:-python3}"
fi
PIPELINE="$SCRIPT_DIR/birdid.py"

# ---- helpers --------------------------------------------------------------
say() { printf '%s\n' "$*"; }
die() { printf 'birdid: ERROR: %s\n' "$*" >&2; exit 1; }

# ---- doctor: launcher self-diagnostics -------------------------------------
# `birdid --doctor` verifies this launcher's own health so a confusing mid-run
# syntax error (the file being edited while bash is reading it) is instantly
# diagnosable. It runs EARLY and exits BEFORE the pipeline invocation, so it can
# inspect a launcher whose tail is corrupt (the two past failure signatures:
# a stray 'cache (no region = drop stale)"' line and a stray extra 'fi').
_doctor() {
    local bad=0 tmp repo real inst
    tmp="/tmp/birdid_doctor_$$.syntax"
    echo "birdid: --doctor: launcher self-diagnostics"
    echo "  script      : $(_realpath "$0")"
    echo "  pipeline    : $PIPELINE"

    # 1. this file parses
    if bash -n "$0" 2>"$tmp"; then
        echo "  [ok] bash -n: syntax OK"
    else
        echo "  [!!] bash -n reports a syntax error:"
        sed 's/^/        /' "$tmp"
        bad=1
    fi
    rm -f "$tmp"

    # 2. control-keyword balance (catches a stray extra fi/esac/done)
    local nif nfi ncase nesac nfor ndone
    nif=$(grep -cE '^[[:space:]]*if[[:space:]]' "$0" || true)
    nfi=$(grep -cE '^[[:space:]]*fi([[:space:]]|$)' "$0" || true)
    ncase=$(grep -cE '^[[:space:]]*case[[:space:]]' "$0" || true)
    nesac=$(grep -cE '^[[:space:]]*esac([[:space:]]|$)' "$0" || true)
    nfor=$(grep -cE '^[[:space:]]*for[[:space:]]' "$0" || true)
    ndone=$(grep -cE '^[[:space:]]*done([[:space:]]|$)' "$0" || true)
    echo "  structural : if=$nif fi=$nfi case=$ncase esac=$nesac for=$nfor done=$ndone"
    if [ "$nif" -ne "$nfi" ] || [ "$ncase" -ne "$nesac" ] || [ "$nfor" -ne "$ndone" ]; then
        echo "  [!!] unbalanced control keywords (stray fragment?)"
        bad=1
    else
        echo "  [ok] control keywords balanced"
    fi

    # 3. known stray-fragment signature (the 'cache (no region = drop stale)"' error)
    if grep -qE '^[[:space:]]*cache \(no region = drop stale\)"?' "$0"; then
        echo "  [!!] stray help fragment found (bare 'cache (no region = drop stale)')"
        bad=1
    else
        echo "  [ok] no known stray fragments"
    fi

    # 4. matches the committed version
    repo="$(cd "$SCRIPT_DIR/.." && pwd)"
    if [ -d "$repo/.git" ]; then
        if git -C "$repo" diff --quiet -- pipeline/birdid 2>/dev/null \
           && [ -z "$(git -C "$repo" status --porcelain -- pipeline/birdid)" ]; then
            echo "  [ok] launcher matches the committed version (HEAD)"
        else
            echo "  [!!] launcher differs from the committed version:"
            git -C "$repo" diff --stat -- pipeline/birdid 2>/dev/null | sed 's/^/        /'
            bad=1
        fi
    else
        echo "  [?] no git repo at $repo (committed-version check skipped)"
    fi

    # 5. install layout: ~/.local/bin/birdid is a symlink to this file
    real="$(_realpath "$0")"
    if [ -L "$HOME/.local/bin/birdid" ]; then
        inst="$(_realpath "$HOME/.local/bin/birdid")"
        if [ "$inst" = "$real" ]; then
            echo "  [ok] ~/.local/bin/birdid -> $real"
        else
            echo "  [!!] ~/.local/bin/birdid -> $inst (points elsewhere, not $real)"
            bad=1
        fi
    elif [ -f "$HOME/.local/bin/birdid" ]; then
        echo "  [!!] ~/.local/bin/birdid is a REGULAR file (the symlink was replaced)"
        bad=1
    else
        echo "  [?] ~/.local/bin/birdid not present (not installed via ~/.local/bin)"
    fi

    # 6. pipeline + venv present
    if [ -f "$PIPELINE" ]; then
        echo "  [ok] pipeline present: $PIPELINE"
    else
        echo "  [!!] pipeline missing: $PIPELINE"
        bad=1
    fi
    if [ -x "$VENV/bin/python" ]; then
        echo "  [ok] project venv python: $VENV/bin/python"
    else
        echo "  [~] no project venv (will use $PY)"
    fi

    if [ "$bad" -eq 0 ]; then
        echo "birdid: --doctor: all checks passed"
    else
        echo "birdid: --doctor: PROBLEMS FOUND - restore the launcher with:"
        echo "  git -C $repo checkout -- pipeline/birdid"
        echo "  ln -sf $repo/pipeline/birdid $HOME/.local/bin/birdid"
    fi
    exit "$bad"
}

# run --doctor before anything heavy so a launcher whose tail is corrupt can
# still be inspected (a corrupt tail never gets parsed if we exit here).
if [ "$#" -ge 1 ] && [ "$1" = "--doctor" ]; then
    _doctor
fi

# ---- main -----------------------------------------------------------------
if [ "$#" -eq 0 ]; then
    say "usage: birdid /path/to/photos [birdid.py args...]"
    say "       (--force re-identifies an already-tagged folder in place,"
    say "        keeping the existing sidecars and only overwriting the bird-ID"
    say "        fields)"
    say "       (--burst combines a rapid series of shots of the same bird"
    say "        into one stronger ID - opt-in; the per-capture mode stays"
    say "        the default; tune with --burst-gap / --burst-sim)"
    say "       (--partial-only re-identifies only captures whose group is"
    say "        known but the species isn't - each prefixed to that group,"
    say "        e.g. 'Mammal' - instead of rescanning the whole folder)"
    say ""
    say "data management (no folder):"
    say "  birdid --list [country|region]     what's available to download"
    say "  birdid --download <code>           write a real eBird table to the"
    say "                                     gitignored regions_generated/ dir"
    say "                                     (needs --api key; never committed)"
    say "  birdid --update <code>             refresh only the tables whose eBird"
    say "                                     data is newer than what's stored"
    say "  birdid --download taxonomy         fetch the keyless eBird/Clements"
    say "                                     taxonomy (no key needed)"
    say "  birdid --download region SA        batch: whole continent/subcontinent"
    say "                                     (NA/SA/AF/AS/OC, EU-NORTH,"
    say "                                     AS-SOUTHEAST, NA-CARIBBEAN, ...)"
    say "  birdid --cache build <region>      precompute a region's species-"
    say "                                     embedding cache (no API key)"
    say "  birdid --cache clean <region>      remove that region's data from the"
    say "                                     cache (no region = drop stale)"
    say "  birdid --cache update              sync the cache with the eBird tables"
    say "  birdid --api [<key>]               store / show the eBird API key"
    say "  birdid --initialize                one-time: taxonomy + BioCLIP 2 backends"
    say "  birdid --download-detector         (optional) dedicated ONNX multi-bird"
    say "                                     detector - separate, opt-in download"
    say "  birdid --onnx-encoder             OPT-IN: int8 ONNX CPU image"
    say "                                     encoder (torch is the default;"
    say "                                     installing onnxruntime for the"
    say "                                     ONNX detector does NOT flip it)"
    say "  birdid --no-onnx-encoder           force the pybioclip CPU encoder"
    say "                                     (no int8 ONNX fast path)"
    say "  birdid --list-candidates           inspect the region/month tables"
    say "  birdid --doctor                    check the launcher's own health"
    say ""
    say "run 'birdid --help' for all options"
    exit 2
fi

# sanity: the pipeline script exists
[ -f "$PIPELINE" ] || die "pipeline not found: $PIPELINE"

# management commands run WITHOUT a photo folder and may need the network
# (--download / --update / --api / --initialize / --download-backends /
# --download-detector);
# --list / --cache / --list-candidates are local-only but harmless to run
# online. Everything that has a folder is a real identification run and must
# stay fully offline.
MGMT=0
OFFLINE=0
for a in "$@"; do
    case "$a" in
        -d|--download|-u|--update|--list|--api|--initialize|--download-backends|--download-detector|--cache|--list-candidates|--doctor|-h|--help)
            MGMT=1 ;;
        --download=*|--update=*|--list=*|--api=*|--initialize=*) MGMT=1 ;;
    esac
    # --cache only touches already-downloaded data (local eBird tables and the
    # pre-cached BioCLIP model), so it runs fully offline too.
    case "$a" in
        --cache) OFFLINE=1 ;;
    esac
done

if [ "$MGMT" -eq 0 ] || [ "$OFFLINE" -eq 1 ]; then
    # real runs and --cache: guarantee fully-offline operation. The BioCLIP/TOL
    # backends are predownloaded with `--initialize` / `--download-backends`.
    export HF_HUB_OFFLINE=1
    export TRANSFORMERS_OFFLINE=1
fi

# Stream progress LIVE: when stdout is a pipe (the viewer's manage/run console
# reads it line-by-line), python block-buffers print() output (~8 KB), so a
# --download / --update / --cache / photo run would show nothing until it
# exits. Unbuffered flushes every line as it is written, and the env var is
# inherited by child python processes (e.g. the pip auto-install) too.
export PYTHONUNBUFFERED=1

"$PY" "$PIPELINE" "$@"
rc=$?

exit "$rc"
